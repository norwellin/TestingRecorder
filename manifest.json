{
  "manifest_version": 3,
  "name": "My Recorder_Dom new",
  "version": "1.0",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "windows",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dialogHook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bundle.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Iframe Drag Detector"
  }
}
